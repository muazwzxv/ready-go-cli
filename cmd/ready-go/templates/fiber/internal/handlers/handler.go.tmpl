package handlers

import (
	"context"
	"log/slog"
	"time"

	"github.com/gofiber/fiber/v3"
	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/attribute"
	"go.opentelemetry.io/otel/codes"
	"go.opentelemetry.io/otel/propagation"
	"go.opentelemetry.io/otel/trace"
	"{{.ModuleName}}/cmd"
	"{{.ModuleName}}/internal/handlers/{{.SampleAPINameLower}}"
)

func SetupHandler(ctx context.Context, router *fiber.App, svc *cmd.APIService) {
	router.Use(TracingMiddleware())
	router.Use(LoggingMiddleware())

	setup{{.SampleAPIName}}Handlers(ctx, router, svc)
}

func setup{{.SampleAPIName}}Handlers(ctx context.Context, router *fiber.App, svc *cmd.APIService) {
	handler := &{{.SampleAPINameLower}}.GetByIDHandler{
		DB:      svc.DB,
		Queries: svc.Queries,
		Redis:   svc.Redis,
	}
	router.Get("/v1/{{.SampleAPINameLower}}s/:id", handler.Handle)
	slog.InfoContext(ctx, "Registered {{.SampleAPINameLower}} handlers")
}

func TracingMiddleware() fiber.Handler {
	tracer := otel.Tracer("{{.ModuleName}}")
	prop := otel.GetTextMapPropagator()

	return func(c fiber.Ctx) error {
		ctx := prop.Extract(c.Context(), propagation.HeaderCarrier(c.GetReqHeaders()))

		route := c.Route().Path
		if route == "" {
			route = c.Path()
		}

		ctx, span := tracer.Start(ctx, c.Method()+" "+route,
			trace.WithAttributes(
				attribute.String("http.request.method", c.Method()),
				attribute.String("http.route", route),
			),
			trace.WithSpanKind(trace.SpanKindServer),
		)
		defer span.End()

		c.SetContext(ctx)
		err := c.Next()

		span.SetAttributes(attribute.Int("http.response.status_code", c.Response().StatusCode()))
		if err != nil {
			span.SetStatus(codes.Error, err.Error())
			span.RecordError(err)
		}
		return err
	}
}

func LoggingMiddleware() fiber.Handler {
	return func(c fiber.Ctx) error {
		start := time.Now()
		err := c.Next()
		slog.InfoContext(c.Context(), "request",
			"method", c.Method(),
			"path", c.Path(),
			"status", c.Response().StatusCode(),
			"duration", time.Since(start),
			"ip", c.IP(),
		)
		return err
	}
}
